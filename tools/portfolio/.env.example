# 複製成 .env 再填。.env 不會被上傳（已列在 .gitignore）。
# 每家只開「讀取」權限，不要勾交易、提領、轉帳。沒有的交易所留空就會跳過。

BYBIT_KEY=
BYBIT_SECRET=

OKX_KEY=
OKX_SECRET=
OKX_PASSWORD=

BINANCE_KEY=
BINANCE_SECRET=

BITGET_KEY=
BITGET_SECRET=
BITGET_PASSWORD=

# 加密結果用的密碼，幣策略 App 解鎖時輸入同一組。至少 12 位，不要跟其他帳號共用。
PORTFOLIO_PASSWORD=

# 你電腦上 coin-app 的資料夾位置（git clone 下來的那個）
REPO_DIR=C:\Users\你的名字\coin-app

# 1 = 跑完自動 commit 並 push 到 GitHub；0 = 只產生檔案
PUSH=1

# 美金換台幣匯率（只用來顯示台幣約值）
USDTWD=32
